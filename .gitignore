# Word lock files
~$*.docx

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
config/*secret*.yaml
config/*secrets*.yaml
config/local*.yaml

# Private / de-anonymizing artifacts — never commit
data/professors_private.csv
data/private/*
!data/private/.gitkeep
!data/private/raw_pdfs/
data/private/raw_pdfs/*
!data/private/raw_pdfs/.gitkeep
data/private/professor_identity_map.csv
data/private/*identity*map*
# annotations/blinding_map.csv — un-ignored for the journal revision (see decision log).
# It holds only anonymous IDs (claim/email/run/professor CS-01..BIO-04, condition, seed);
# verified free of real names. Required to reproduce every per-condition statistic, and
# the annotation-blinding it protected ended when labelling finished.

# Collection caches and temporary request artifacts
data/raw/cache/
data/raw/progress/
data/**/.cache/
*.http-cache
*.sqlite-wal
*.sqlite-shm
*.tmp

# Generated run artifacts (committed selectively after pilot sign-off)
outputs/*.jsonl
logs/*.csv

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Internal team/agent artifacts — kept local, not part of the research repo
handoff/
docs/superpowers/
docs/source/
paper/main_nsri_draft.md
paper/outline.md
annotations/human_check.md
annotations/claims_to_label_final.csv
annotations/claims_to_label_final1.csv
