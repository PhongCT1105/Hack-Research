{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/outreach-eval/schemas/evidence_packet.schema.json",
  "title": "Expanded benchmark evidence packet",
  "description": "Internal benchmark-v1 packet with anonymous primary key and traceable evidence. No synthetic record is embedded in this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "evidence_packet_version",
    "professor_id",
    "benchmark_metadata",
    "profile",
    "papers",
    "focal_paper_ids",
    "passages",
    "provenance",
    "quality_control"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "evidence_packet_version": {"type": "string", "minLength": 1},
    "professor_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,15}-[0-9]{2,3}$"},
    "benchmark_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "field",
        "subfield",
        "career_stage",
        "career_stage_source",
        "visibility_tier",
        "research_breadth_tier",
        "topic_coherence_tier",
        "method_diversity_tier",
        "paper_complexity_tier",
        "synthesis_difficulty_tier",
        "evidence_completeness_score",
        "evidence_ambiguity_score"
      ],
      "properties": {
        "domain": {"type": "string"},
        "field": {"type": "string"},
        "subfield": {"type": "string"},
        "career_stage": {"enum": ["early", "mid", "senior"]},
        "career_stage_source": {"enum": ["official_faculty_page", "estimated_from_first_publication_year"]},
        "visibility_tier": {"enum": ["lower", "medium", "higher"]},
        "research_breadth_tier": {"enum": ["narrow", "moderate", "broad"]},
        "topic_coherence_tier": {"enum": ["low", "medium", "high"]},
        "method_diversity_tier": {"enum": ["low", "medium", "high"]},
        "paper_complexity_tier": {"enum": ["low", "medium", "high"]},
        "synthesis_difficulty_tier": {"enum": ["low", "medium", "high"]},
        "evidence_completeness_score": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ambiguity_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faculty_status_verified", "faculty_page_url", "faculty_title", "retrieved_at", "research_summary"],
      "properties": {
        "faculty_status_verified": {"const": true},
        "faculty_page_url": {"type": "string", "format": "uri"},
        "faculty_title": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date"},
        "research_summary": {"type": "string", "minLength": 1}
      }
    },
    "papers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "paper.schema.json"}
    },
    "focal_paper_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "passages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/passage"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "retrieval_window", "candidate_pool_version", "collection_code_version"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "retrieval_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"}
          }
        },
        "candidate_pool_version": {"type": "string", "minLength": 1},
        "collection_code_version": {"type": "string", "minLength": 1},
        "reconciliation_notes": {"type": ["string", "null"]}
      }
    },
    "quality_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validated",
        "unique_professor_id_validated",
        "paper_count_validated",
        "focal_paper_count_validated",
        "passage_count_validated",
        "source_urls_validated",
        "retrieval_dates_validated",
        "authorship_verified",
        "author_profile_merge_split_resolved",
        "public_identity_scan_passed",
        "raw_pdf_commit_scan_passed",
        "human_reviewer",
        "reviewed_at"
      ],
      "properties": {
        "schema_validated": {"const": true},
        "unique_professor_id_validated": {"const": true},
        "paper_count_validated": {"const": true},
        "focal_paper_count_validated": {"const": true},
        "passage_count_validated": {"const": true},
        "source_urls_validated": {"const": true},
        "retrieval_dates_validated": {"const": true},
        "authorship_verified": {"const": true},
        "author_profile_merge_split_resolved": {"const": true},
        "public_identity_scan_passed": {"const": true},
        "raw_pdf_commit_scan_passed": {"const": true},
        "human_reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "paper_id", "section", "page_number", "passage_text", "source_id", "source_url", "retrieved_at", "license_access_note", "selection_rationale"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1},
        "section": {"enum": ["introduction_objective", "methods", "results", "discussion_limitations", "other"]},
        "page_number": {"type": ["integer", "string", "null"]},
        "passage_text": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date"},
        "license_access_note": {"type": "string", "minLength": 1},
        "selection_rationale": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "provider", "url", "retrieved_at", "checksum", "access_note"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "provider": {"enum": ["official_faculty_page", "orcid", "openalex", "semantic_scholar", "crossref", "unpaywall", "publisher", "repository", "other"]},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date"},
        "checksum": {"type": "string", "minLength": 1},
        "access_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
