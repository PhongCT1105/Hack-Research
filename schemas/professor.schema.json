{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/outreach-eval/schemas/professor.schema.json",
  "title": "Expanded benchmark professor record",
  "description": "Internal benchmark-v1 record. Public exports must remove identity-bearing fields and use professor_id only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "professor_id",
    "faculty_verification",
    "research_classification",
    "career",
    "visibility",
    "portfolio_dimensions",
    "quality_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "professor_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,15}-[0-9]{2,3}$",
      "description": "Anonymous benchmark identifier. Synthetic format example only: CS-017."
    },
    "openalex_author_id": {
      "type": ["string", "null"],
      "pattern": "^(https://openalex\\.org/)?A[0-9]+$",
      "description": "Identity-bearing internal field; remove from public anonymous exports."
    },
    "orcid": {
      "type": ["string", "null"],
      "pattern": "^(https://orcid\\.org/)?[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"
    },
    "faculty_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faculty_status_verified",
        "faculty_page_url",
        "faculty_title",
        "faculty_page_retrieved_at",
        "identity_notes"
      ],
      "properties": {
        "faculty_status_verified": {"const": true},
        "faculty_page_url": {"type": "string", "format": "uri"},
        "faculty_title": {"type": "string", "minLength": 1},
        "faculty_page_retrieved_at": {"type": "string", "format": "date"},
        "research_summary": {"type": ["string", "null"]},
        "identity_notes": {"type": "string"},
        "verified_by": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"], "format": "date"}
      }
    },
    "research_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "field", "subfield", "primary_topics", "openalex_topic_ids", "human_reviewed"],
      "properties": {
        "domain": {
          "enum": [
            "computer_science_engineering",
            "biomedical_public_health",
            "psychology_cognitive_science",
            "physical_mathematical_sciences",
            "social_sciences_humanities"
          ]
        },
        "field": {"type": "string", "minLength": 1},
        "subfield": {"type": "string", "minLength": 1},
        "primary_topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "openalex_topic_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(https://openalex\\.org/)?T[0-9]+$"}
        },
        "human_reviewed": {"type": "boolean"},
        "classification_notes": {"type": ["string", "null"]}
      }
    },
    "career": {
      "type": "object",
      "additionalProperties": false,
      "required": ["career_stage", "career_stage_source", "faculty_title", "first_publication_year", "academic_age_years"],
      "properties": {
        "career_stage": {"enum": ["early", "mid", "senior"]},
        "career_stage_source": {"enum": ["official_faculty_page", "estimated_from_first_publication_year"]},
        "faculty_title": {"type": "string", "minLength": 1},
        "first_publication_year": {"type": "integer", "minimum": 1800, "maximum": 2200},
        "academic_age_years": {"type": "integer", "minimum": 0},
        "rank_verified": {"type": "boolean", "default": false}
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_citation_count",
        "h_index",
        "works_count",
        "field_normalized_citation_percentile",
        "visibility_percentile",
        "visibility_tier",
        "normalization_stratum",
        "components_available"
      ],
      "properties": {
        "total_citation_count": {"type": "integer", "minimum": 0},
        "h_index": {"type": "integer", "minimum": 0},
        "works_count": {"type": "integer", "minimum": 0},
        "field_normalized_citation_percentile": {"$ref": "#/$defs/score100"},
        "visibility_percentile": {"$ref": "#/$defs/score100"},
        "visibility_tier": {"enum": ["lower", "medium", "higher"]},
        "normalization_stratum": {"type": "string", "minLength": 1},
        "components_available": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "public_profile_indicators": {
          "type": "object",
          "additionalProperties": {"type": ["number", "integer", "boolean", "string", "null"]}
        }
      }
    },
    "portfolio_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_breadth",
        "topic_coherence",
        "method_diversity",
        "paper_complexity",
        "synthesis_difficulty"
      ],
      "properties": {
        "research_breadth": {
          "allOf": [
            {"$ref": "#/$defs/scoredTier"},
            {
              "type": "object",
              "properties": {
                "tier": {"enum": ["narrow", "moderate", "broad"]},
                "unique_topic_count": {"type": "integer", "minimum": 0},
                "unique_subfield_count": {"type": "integer", "minimum": 0},
                "unique_field_count": {"type": "integer", "minimum": 0},
                "topic_entropy": {"type": "number", "minimum": 0},
                "topic_cluster_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
              },
              "required": ["unique_topic_count", "unique_subfield_count", "unique_field_count", "topic_entropy", "topic_cluster_distribution"]
            }
          ]
        },
        "topic_coherence": {
          "allOf": [
            {"$ref": "#/$defs/scoredTier"},
            {
              "type": "object",
              "properties": {
                "tier": {"enum": ["low", "medium", "high"]},
                "mean_pairwise_similarity": {"type": "number", "minimum": -1, "maximum": 1},
                "human_reviewed": {"const": true}
              },
              "required": ["mean_pairwise_similarity", "human_reviewed"]
            }
          ]
        },
        "method_diversity": {
          "allOf": [
            {"$ref": "#/$defs/scoredTier"},
            {
              "type": "object",
              "properties": {
                "tier": {"enum": ["low", "medium", "high"]},
                "method_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "method_count": {"type": "integer", "minimum": 0},
                "method_entropy": {"type": "number", "minimum": 0}
              },
              "required": ["method_families", "method_count", "method_entropy"]
            }
          ]
        },
        "paper_complexity": {
          "allOf": [
            {"$ref": "#/$defs/scoredTier"},
            {
              "type": "object",
              "properties": {
                "tier": {"enum": ["low", "medium", "high"]},
                "selected_paper_mean": {"$ref": "#/$defs/score100"},
                "selected_paper_median": {"$ref": "#/$defs/score100"}
              },
              "required": ["selected_paper_mean", "selected_paper_median"]
            }
          ]
        },
        "synthesis_difficulty": {
          "allOf": [
            {"$ref": "#/$defs/scoredTier"},
            {
              "type": "object",
              "properties": {
                "tier": {"enum": ["low", "medium", "high"]},
                "automated_tier": {"enum": ["low", "medium", "high"]},
                "components": {"$ref": "#/$defs/synthesisComponents"},
                "human_reviewed": {"const": true},
                "override_reason": {"type": ["string", "null"]}
              },
              "required": ["automated_tier", "components", "human_reviewed", "override_reason"]
            }
          ]
        }
      }
    },
    "institution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "openalex_id": {"type": ["string", "null"]},
        "ror_id": {"type": ["string", "null"]},
        "type": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]},
        "research_visibility": {"type": ["number", "null"]}
      }
    },
    "secondary_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faculty_page_language": {"type": ["string", "null"]},
        "publication_languages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "average_author_count": {"type": ["number", "null"], "minimum": 0},
        "unique_collaborator_count": {"type": ["integer", "null"], "minimum": 0},
        "multi_institution_collaboration_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "temporal_publication_span_years": {"type": ["integer", "null"], "minimum": 0},
        "research_evolution_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "dataset_population_diversity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "open_access_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_completeness_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_ambiguity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "quality_status": {"enum": ["candidate", "needs_review", "eligible", "selected", "excluded"]},
    "exclusion_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "score100": {"type": "number", "minimum": 0, "maximum": 100},
    "scoredTier": {
      "type": "object",
      "required": ["score", "tier", "score_version", "normalization_stratum"],
      "properties": {
        "score": {"$ref": "#/$defs/score100"},
        "tier": {"type": "string"},
        "score_version": {"type": "string", "minLength": 1},
        "normalization_stratum": {"type": "string", "minLength": 1}
      }
    },
    "synthesisComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_entropy",
        "mean_semantic_distance",
        "topic_cluster_count",
        "method_diversity",
        "dataset_population_diversity",
        "temporal_research_evolution",
        "cross_domain_breadth",
        "inverse_topic_coherence"
      ],
      "properties": {
        "topic_entropy": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_semantic_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "topic_cluster_count": {"type": "number", "minimum": 0, "maximum": 1},
        "method_diversity": {"type": "number", "minimum": 0, "maximum": 1},
        "dataset_population_diversity": {"type": "number", "minimum": 0, "maximum": 1},
        "temporal_research_evolution": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_domain_breadth": {"type": "number", "minimum": 0, "maximum": 1},
        "inverse_topic_coherence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
