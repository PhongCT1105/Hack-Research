# Copy this file to .env and provide your own credentials.
# .env is gitignored — never commit real keys.
OPENALEX_API_KEY=replace_with_your_openalex_api_key

# Pipeline LLM providers (only the ones your config/config.yaml roles use are required).
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key
# OpenRouter: one key, many model families (incl. free ':free' variants) — good for
# dev/pilot testing before spending on pinned paid models. Get a key at openrouter.ai.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
